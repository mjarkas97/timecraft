{
  "name": "timecraft",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p server/tsconfig.json",
    "test": "tsx --test server/db.test.ts server/routes/projects.test.ts server/routes/entries.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tsconfig/svelte": "^5.0.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.13.2",
    "concurrently": "^9.2.1",
    "sass": "^1.101.7",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
